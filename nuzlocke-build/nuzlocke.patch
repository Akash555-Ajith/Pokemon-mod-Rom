diff --git a/src/shop.c b/src/shop.c
index c6e7881..d0f6067 100644
--- a/src/shop.c
+++ b/src/shop.c
@@ -377,7 +377,22 @@ static void SetShopMenuCallback(void (*callback)(void))
 
 static void SetShopItemsForSale(const u16 *items)
 {
+    static u16 balls[32];
     u16 i = 0;
+    u16 count = 0;
+
+    if (sMartInfo.martType == MART_TYPE_NORMAL)
+    {
+        while (items[i] != ITEM_NONE)
+        {
+            if (GetItemPocket(items[i]) == POCKET_POKE_BALLS && count < ARRAY_COUNT(balls) - 1)
+                balls[count++] = items[i];
+            i++;
+        }
+        balls[count] = ITEM_NONE;
+        items = balls;
+        i = 0;
+    }
 
     sMartInfo.itemList = items;
     sMartInfo.itemCount = 0;
