diff --git a/src/nuzlocke.c b/src/nuzlocke.c
new file mode 100644
index 0000000..a1af5e2
--- /dev/null
+++ b/src/nuzlocke.c
@@ -0,0 +1,233 @@
+#include "global.h"
+#include "nuzlocke.h"
+#include "battle.h"
+#include "event_data.h"
+#include "event_object_movement.h"
+#include "field_camera.h"
+#include "fieldmap.h"
+#include "main.h"
+#include "overworld.h"
+#include "palette.h"
+#include "pokemon.h"
+#include "pokemon_storage_system.h"
+#include "save.h"
+#include "script.h"
+#include "sprite.h"
+#include "task.h"
+#include "constants/event_bg.h"
+#include "constants/flags.h"
+
+extern const struct SpriteTemplate gFieldEffectObjectTemplate_SmallSparkle;
+extern const struct SpritePalette gSpritePalette_SmallSparkle;
+
+EWRAM_DATA static bool8 sSavePending = FALSE;
+
+u8 NuzlockeLevelCap(void)
+{
+    static const u16 badges[] = {FLAG_BADGE01_GET, FLAG_BADGE02_GET, FLAG_BADGE03_GET,
+        FLAG_BADGE04_GET, FLAG_BADGE05_GET, FLAG_BADGE06_GET, FLAG_BADGE07_GET, FLAG_BADGE08_GET};
+    static const u8 caps[] = {15, 19, 24, 29, 31, 33, 42, 46};
+    u32 i;
+    for (i = 0; i < ARRAY_COUNT(badges); i++)
+        if (!FlagGet(badges[i]))
+            return caps[i];
+    return MAX_LEVEL;
+}
+
+u32 NuzlockeBoxExpGain(struct BoxPokemon *mon, u32 gain)
+{
+    u16 species = GetBoxMonData(mon, MON_DATA_SPECIES);
+    u32 current = GetBoxMonData(mon, MON_DATA_EXP);
+    u32 limit = gExperienceTables[gSpeciesInfo[species].growthRate][NuzlockeLevelCap()];
+    if (current >= limit)
+        return 0;
+    if (gain > limit - current)
+        return limit - current;
+    return gain;
+}
+
+u32 NuzlockeExpGain(struct Pokemon *mon, u32 gain)
+{
+    return NuzlockeBoxExpGain(&mon->box, gain);
+}
+
+// One saved bit per named area: floors/entrances of the same cave share a chance.
+// This is reserved, unused save space; the layout of vanilla save blocks is unchanged.
+bool8 NuzlockeEncounterUsed(void)
+{
+    u8 area = GetCurrentRegionMapSectionId();
+    return (gSaveBlock1Ptr->unused_3598[area >> 3] & (1 << (area & 7))) != 0;
+}
+
+void NuzlockeUseEncounter(void)
+{
+    u8 area = GetCurrentRegionMapSectionId();
+    gSaveBlock1Ptr->unused_3598[area >> 3] |= 1 << (area & 7);
+    sSavePending = TRUE;
+}
+
+static void Task_SkipUsedEncounter(u8 taskId)
+{
+    gSpecialVar_Result = B_OUTCOME_RAN;
+    ScriptContext_Enable();
+    DestroyTask(taskId);
+}
+
+bool8 NuzlockeTryScriptedEncounter(void)
+{
+    if (NuzlockeEncounterUsed())
+    {
+        CreateTask(Task_SkipUsedEncounter, 1);
+        return FALSE;
+    }
+    NuzlockeUseEncounter();
+    return TRUE;
+}
+
+void NuzlockeRequestSave(void)
+{
+    sSavePending = TRUE;
+}
+
+bool8 NuzlockeRemoveFainted(void)
+{
+    u32 i;
+    bool8 living = FALSE;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (!GetMonData(&gPlayerParty[i], MON_DATA_SPECIES)
+            || GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG))
+            continue;
+        if (GetMonData(&gPlayerParty[i], MON_DATA_HP) == 0)
+        {
+            ZeroMonData(&gPlayerParty[i]);
+            sSavePending = TRUE;
+        }
+        else
+            living = TRUE;
+    }
+    CompactPartySlots();
+    CalculatePlayerPartyCount();
+    return !living;
+}
+
+bool8 NuzlockeEndBattle(void)
+{
+    u32 i, j;
+    u32 count = (gBattleTypeFlags & BATTLE_TYPE_INGAME_PARTNER) ? 3 : PARTY_SIZE;
+    bool8 living = FALSE;
+    if (gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_RECORDED | BATTLE_TYPE_WALLY_TUTORIAL))
+        return FALSE;
+    for (i = 0; i < count; i++)
+    {
+        struct Pokemon *mon = &gPlayerParty[i];
+        if (!GetMonData(mon, MON_DATA_SPECIES) || GetMonData(mon, MON_DATA_IS_EGG))
+            continue;
+        if (GetMonData(mon, MON_DATA_HP))
+            living = TRUE;
+        else
+        {
+            // Also remove the same individual from the pre-battle party backup.
+            // Partner/facility scripts must not restore a dead Pokemon later.
+            for (j = 0; j < PARTY_SIZE; j++)
+            {
+                struct Pokemon *saved = &gSaveBlock1Ptr->playerParty[j];
+                if (GetMonData(saved, MON_DATA_SPECIES)
+                    && GetMonData(saved, MON_DATA_PERSONALITY) == GetMonData(mon, MON_DATA_PERSONALITY)
+                    && GetMonData(saved, MON_DATA_OT_ID) == GetMonData(mon, MON_DATA_OT_ID))
+                    ZeroMonData(saved);
+            }
+            ZeroMonData(mon);
+        }
+    }
+    // Selected-party battle scripts still use original slot indexes on return.
+    if (!(gBattleTypeFlags & (BATTLE_TYPE_FRONTIER | BATTLE_TYPE_INGAME_PARTNER)))
+    {
+        CompactPartySlots();
+        CalculatePlayerPartyCount();
+    }
+    sSavePending = TRUE;
+    return !living;
+}
+
+void NuzlockeRestart(void)
+{
+    sSavePending = FALSE;
+    SetVBlankCallback(NULL);
+    SetHBlankCallback(NULL);
+    ClearSaveData();
+    Save_ResetSaveCounters();
+    gMain.inBattle = FALSE;
+    SetMainCallback1(NULL);
+    SetMainCallback2(CB2_NewGame);
+}
+
+static bool8 MarkerPosition(u16 eventId, s16 *x, s16 *y)
+{
+    const struct BgEvent *event = &gMapHeader.events->bgEvents[eventId];
+    if (event->kind != BG_EVENT_HIDDEN_ITEM
+        || FlagGet(event->bgUnion.hiddenItem.hiddenItemId + FLAG_HIDDEN_ITEMS_START))
+        return FALSE;
+    *x = event->x + MAP_OFFSET;
+    *y = event->y + MAP_OFFSET;
+    SetSpritePosToOffsetMapCoords(x, y, 8, 8);
+    return *x + gSpriteCoordOffsetX >= -8 && *x + gSpriteCoordOffsetX <= DISPLAY_WIDTH + 8
+        && *y + gSpriteCoordOffsetY >= -8 && *y + gSpriteCoordOffsetY <= DISPLAY_HEIGHT + 8;
+}
+
+static void SpriteCB_HiddenItemMarker(struct Sprite *sprite)
+{
+    s16 x, y;
+    if (sprite->data[1] != gSaveBlock1Ptr->location.mapGroup
+        || sprite->data[2] != gSaveBlock1Ptr->location.mapNum
+        || sprite->data[0] >= gMapHeader.events->bgEventCount
+        || !MarkerPosition(sprite->data[0], &x, &y))
+    {
+        DestroySprite(sprite);
+        return;
+    }
+    sprite->x = x;
+    sprite->y = y;
+    if (sprite->animEnded)
+        StartSpriteAnim(sprite, 0);
+}
+
+void NuzlockeFieldUpdate(void)
+{
+    u32 i, j;
+    s16 x, y;
+    u8 spriteId;
+    if (sSavePending && !gMain.inBattle && !gPaletteFade.active
+        && !ScriptContext_IsEnabled() && !ArePlayerFieldControlsLocked()
+        && gMain.callback2 == CB2_Overworld)
+    {
+        sSavePending = FALSE;
+        SaveMapView();
+        TrySavingData(SAVE_NORMAL);
+    }
+    if (gMapHeader.events == NULL)
+        return;
+    for (i = 0; i < gMapHeader.events->bgEventCount; i++)
+    {
+        if (!MarkerPosition(i, &x, &y))
+            continue;
+        for (j = 0; j < MAX_SPRITES; j++)
+            if (gSprites[j].inUse && gSprites[j].callback == SpriteCB_HiddenItemMarker
+                && gSprites[j].data[0] == i
+                && gSprites[j].data[1] == gSaveBlock1Ptr->location.mapGroup
+                && gSprites[j].data[2] == gSaveBlock1Ptr->location.mapNum)
+                break;
+        if (j != MAX_SPRITES)
+            continue;
+        LoadSpritePalette(&gSpritePalette_SmallSparkle);
+        spriteId = CreateSpriteAtEnd(&gFieldEffectObjectTemplate_SmallSparkle, x, y, 0);
+        if (spriteId == MAX_SPRITES)
+            break;
+        gSprites[spriteId].callback = SpriteCB_HiddenItemMarker;
+        gSprites[spriteId].data[0] = i;
+        gSprites[spriteId].data[1] = gSaveBlock1Ptr->location.mapGroup;
+        gSprites[spriteId].data[2] = gSaveBlock1Ptr->location.mapNum;
+        gSprites[spriteId].oam.priority = 0;
+        gSprites[spriteId].coordOffsetEnabled = TRUE;
+    }
+}
